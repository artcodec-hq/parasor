{
  "name": "@parasor/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PARASOR_AUTH=none HOST=127.0.0.1 PARASOR_CONFIG_DIR=${PARASOR_CONFIG_DIR:-/tmp/parasor-dev} PORT=${PORT:-7682} PARASOR_PTY_DAEMON=${PARASOR_PTY_DAEMON:-0} tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.3.0",
    "@parasor/shared": "workspace:*",
    "@parcel/watcher": "^2.5.6",
    "@xterm/headless": "6.1.0-beta.197",
    "hono": "^4.12.0",
    "ignore": "^7.0.5",
    "node-pty": "1.2.0-beta.12",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "write-file-atomic": "^7.0.1",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/write-file-atomic": "^4.0.3",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0",
    "yazl": "^3.3.1"
  }
}
